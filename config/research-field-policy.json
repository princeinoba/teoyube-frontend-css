{
  "schemaVersion": "1.0.0",
  "policyVersion": "teoyube-research-field-policy-2026-08-04.1",
  "allowedFields": [
    "schemaVersion", "studyVersion", "eventId", "eventName", "eventVersion",
    "studyId", "participantId", "sessionId", "taskId", "timestamp", "route",
    "capability", "result", "completionStatus", "moderatorRescueCount",
    "safeIssueCode", "consentRecordIds", "sourceIds", "scenarioId",
    "accessibilityMode", "rating", "durationBucket", "retentionClass",
    "deletionKey", "cohort", "previousEventHash", "eventHash"
  ],
  "prohibitedFields": [
    "name", "email", "phone", "address", "birthday", "church", "denomination",
    "prayer", "prayerText", "journal", "journalText", "reflection", "reflectionText",
    "testimony", "testimonyText", "checkIn", "checkInText", "memory", "memoryText",
    "health", "diagnosis", "trauma", "abuse", "relationship", "crisis", "rawQuery",
    "rawSearch", "rawPrompt", "rawModelInput", "rawModelOutput", "toolResult",
    "scriptureText", "apiKey", "accessToken", "sessionToken", "cookie", "ipAddress",
    "preciseLocation", "holinessScore", "faithScore", "spiritualRank", "divineFavor",
    "notes", "payload", "freeText", "content", "userId", "contactId"
  ],
  "prohibitedValuePatterns": [
    { "id": "email", "expression": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$", "flags": "i" },
    { "id": "phone", "expression": "(?:\\+?\\d[\\d\\s().-]{7,}\\d)", "flags": "" },
    { "id": "api_key", "expression": "(?:sk-(?:proj-)?[A-Za-z0-9_-]{16,}|AIza[0-9A-Za-z_-]{20,})", "flags": "" },
    { "id": "bearer_token", "expression": "^Bearer\\s+[A-Za-z0-9._~-]{12,}$", "flags": "i" },
    { "id": "jwt", "expression": "^eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "flags": "" },
    { "id": "precise_coordinates", "expression": "^-?\\d{1,2}\\.\\d{4,}\\s*[,/]\\s*-?\\d{1,3}\\.\\d{4,}$", "flags": "" },
    { "id": "raw_multiline_content", "expression": "[\\r\\n]", "flags": "" }
  ],
  "rating": { "minimum": 1, "maximum": 5 },
  "maximumStringLength": 128,
  "maximumArrayItems": 16,
  "sourceIdPattern": "^(?:WEB|TIG|PROMISE|LEXICON|TEO_GUIDE|JOURNEY|MEMORY|SEARCH):[A-Za-z0-9._:-]{1,96}$"
}

{
  "schemaVersion": 1,
  "registryVersion": "teoyube-telemetry-2026-07-24.1",
  "defaultState": "disabled_without_purpose_consent",
  "prohibitedFields": [
    "apiKey",
    "authorization",
    "checkIn",
    "cookie",
    "credential",
    "email",
    "exactIdentity",
    "journal",
    "memoryContent",
    "modelRequest",
    "modelResponse",
    "password",
    "prayer",
    "rawMemory",
    "rawMessage",
    "rawQuery",
    "searchQuery",
    "sessionToken",
    "testimony",
    "toolResult",
    "traumaDetails",
    "vector"
  ],
  "events": [
    {
      "name": "web_request",
      "version": 1,
      "purpose": "Measure preview request reliability without request bodies.",
      "allowedFields": ["route", "traceId", "statusCode", "latencyMs", "timeout", "cancelled", "errorClass", "rateLimitDenied", "resourceBytes"],
      "prohibitedFields": ["rawQuery", "rawMessage", "authorization", "cookie", "sessionToken"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 30,
      "aggregation": "route_status_latency",
      "source": "server_http",
      "owner": "platform"
    },
    {
      "name": "route_readiness",
      "version": 1,
      "purpose": "Measure secret-safe liveness and dependency readiness.",
      "allowedFields": ["route", "traceId", "statusCode", "latencyMs", "safeCode", "fallbackReason"],
      "prohibitedFields": ["privateError", "databaseUrl", "apiKey", "filePath", "userCount"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 30,
      "aggregation": "route_status_latency",
      "source": "health_readiness",
      "owner": "platform"
    },
    {
      "name": "journey_transition",
      "version": 1,
      "purpose": "Measure voluntary journey movement and reversibility.",
      "allowedFields": ["traceId", "journeyStage", "operation", "status", "sourceIds"],
      "prohibitedFields": ["checkIn", "reflectionText", "prayer", "rawMessage"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "journey_stage_operation",
      "source": "journey_application",
      "owner": "product"
    },
    {
      "name": "faithful_action_decision",
      "version": 1,
      "purpose": "Measure whether a user voluntarily accepts, edits, rejects, reflects on, or undoes a suggested action.",
      "allowedFields": ["traceId", "operation", "status", "journeyStage", "sourceIds"],
      "prohibitedFields": ["actionText", "spiritualScore", "faithScore", "rawMessage"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "action_operation",
      "source": "journey_application",
      "owner": "product"
    },
    {
      "name": "reflection_continuity",
      "version": 1,
      "purpose": "Measure consent-safe reflection completion and user-chosen reuse without reflection content.",
      "allowedFields": ["traceId", "operation", "status", "journeyStage", "consentOperation"],
      "prohibitedFields": ["reflectionText", "sentiment", "rawMemory", "checkIn"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "continuity_operation",
      "source": "journey_application",
      "owner": "product"
    },
    {
      "name": "testimony_book_transition",
      "version": 1,
      "purpose": "Measure user-confirmed testimony and Book review transitions without content.",
      "allowedFields": ["traceId", "operation", "status", "sourceIds"],
      "prohibitedFields": ["testimony", "journal", "rawMemory", "divineClaim"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "transition_operation",
      "source": "testimony_application",
      "owner": "product"
    },
    {
      "name": "scripture_retrieval",
      "version": 1,
      "purpose": "Measure exact and lexical Scripture paths and citation validation.",
      "allowedFields": ["traceId", "path", "sourceIds", "resultCount", "latencyMs", "citationValid", "fallbackReason"],
      "prohibitedFields": ["rawQuery", "searchQuery", "rawMessage"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 30,
      "aggregation": "path_result_latency",
      "source": "scripture_repository",
      "owner": "scripture"
    },
    {
      "name": "tig_recommendation",
      "version": 1,
      "purpose": "Measure deterministic TIG path, limits, and fallback without user content.",
      "allowedFields": ["traceId", "path", "sourceIds", "resultCount", "latencyMs", "safeCode", "fallbackReason", "datasetVersion", "rulesetVersion"],
      "prohibitedFields": ["rawQuery", "rawMessage", "callingClaim"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 30,
      "aggregation": "path_result_latency",
      "source": "tig_service",
      "owner": "tig"
    },
    {
      "name": "hybrid_retrieval",
      "version": 1,
      "purpose": "Measure retrieval paths, filters, index version, result count, latency, and fallback.",
      "allowedFields": ["traceId", "path", "sourceIds", "retrievalPartition", "indexVersion", "resultCount", "latencyMs", "trustFilter", "consentFilter", "fallbackReason", "tokenCount", "estimatedCostUsd"],
      "prohibitedFields": ["rawQuery", "searchQuery", "vector", "rawMemory", "modelRequest"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 30,
      "aggregation": "partition_path_latency",
      "source": "retrieval_service",
      "owner": "retrieval"
    },
    {
      "name": "memory_operation",
      "version": 1,
      "purpose": "Measure allowed, denied, export, deletion, and encryption outcomes without memory content.",
      "allowedFields": ["traceId", "operation", "status", "memoryLayer", "safeCode", "keyVersion", "latencyMs"],
      "prohibitedFields": ["rawMemory", "memoryContent", "journal", "prayer", "testimony"],
      "sensitivity": "pseudonymous_operational",
      "consentRequirement": "operational_memory_controls",
      "retentionDays": 30,
      "aggregation": "operation_status",
      "source": "memory_service",
      "owner": "privacy"
    },
    {
      "name": "consent_operation",
      "version": 1,
      "purpose": "Measure consent grant, revoke, expire, and denial outcomes.",
      "allowedFields": ["traceId", "consentOperation", "purposeId", "status", "policyVersion", "safeCode"],
      "prohibitedFields": ["rawMemory", "rawMessage", "exactIdentity"],
      "sensitivity": "pseudonymous_operational",
      "consentRequirement": "none",
      "retentionDays": 90,
      "aggregation": "purpose_operation",
      "source": "consent_ledger",
      "owner": "privacy"
    },
    {
      "name": "deletion_propagation",
      "version": 1,
      "purpose": "Measure deletion and revocation completion and lag.",
      "allowedFields": ["traceId", "operation", "status", "latencyMs", "resultCount", "safeCode"],
      "prohibitedFields": ["rawMemory", "vector", "exactIdentity"],
      "sensitivity": "pseudonymous_operational",
      "consentRequirement": "none",
      "retentionDays": 90,
      "aggregation": "operation_status_latency",
      "source": "deletion_service",
      "owner": "privacy"
    },
    {
      "name": "safety_decision",
      "version": 1,
      "purpose": "Measure deterministic safety routes and prohibited-claim or injection blocks.",
      "allowedFields": ["traceId", "safetyMode", "safeCode", "status", "fallbackReason", "policyVersion", "datasetVersion"],
      "prohibitedFields": ["rawMessage", "traumaDetails", "healthDetails", "relationshipDetails", "modelResponse"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 30,
      "aggregation": "safe_code_status",
      "source": "safety_orchestrator",
      "owner": "safety"
    },
    {
      "name": "live_ai_operation",
      "version": 1,
      "purpose": "Measure guarded provider routing, approved sections, schema results, fallback, usage, and budgets.",
      "allowedFields": ["traceId", "provider", "modelRoute", "modelId", "snapshot", "operation", "status", "latencyMs", "toolName", "toolRounds", "tokenCount", "estimatedCostUsd", "fallbackReason", "safeCode"],
      "prohibitedFields": ["modelRequest", "modelResponse", "rawMessage", "toolResult", "apiKey"],
      "sensitivity": "operational",
      "consentRequirement": "external_ai",
      "retentionDays": 30,
      "aggregation": "provider_model_operation",
      "source": "live_ai_gateway",
      "owner": "ai"
    },
    {
      "name": "source_explanation_inspected",
      "version": 1,
      "purpose": "Measure voluntary inspection of sources, explanations, uncertainty, and limitations.",
      "allowedFields": ["traceId", "operation", "journeyStage", "sourceIds", "status"],
      "prohibitedFields": ["rawMessage", "rawQuery", "interpretationText"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "operation_stage",
      "source": "approved_view_action",
      "owner": "product"
    },
    {
      "name": "clarity_self_reported",
      "version": 1,
      "purpose": "Record the explicit user response that they understand why a suggestion was made.",
      "allowedFields": ["traceId", "status", "journeyStage"],
      "prohibitedFields": ["freeText", "rawMessage", "spiritualScore"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "status_stage",
      "source": "approved_view_action",
      "owner": "product"
    },
    {
      "name": "trust_reversibility_action",
      "version": 1,
      "purpose": "Measure reject, undo, inspect, delete, revoke, fallback, and correction-report actions.",
      "allowedFields": ["traceId", "operation", "status", "safeCode"],
      "prohibitedFields": ["rawMemory", "rawMessage", "citationText"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "operation_status",
      "source": "approved_view_action",
      "owner": "product"
    },
    {
      "name": "cross_module_transition",
      "version": 1,
      "purpose": "Measure consent-safe movement between Teoyube modules.",
      "allowedFields": ["traceId", "fromModule", "toModule", "status", "consentOperation"],
      "prohibitedFields": ["rawMessage", "rawMemory", "sourceContent"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "from_to_status",
      "source": "capability_adapter",
      "owner": "product"
    },
    {
      "name": "community_support_action",
      "version": 1,
      "purpose": "Measure only explicit opening or creation of support prompts and links.",
      "allowedFields": ["traceId", "operation", "status", "safeCode"],
      "prohibitedFields": ["contactIdentity", "contactOutcome", "rawMessage"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "operation_status",
      "source": "approved_view_action",
      "owner": "product"
    },
    {
      "name": "user_quality_report",
      "version": 1,
      "purpose": "Measure explicit unsafe, unhelpful, or citation-correction reports without report content.",
      "allowedFields": ["traceId", "operation", "status", "safeCode", "sourceIds"],
      "prohibitedFields": ["freeText", "rawMessage", "citationText"],
      "sensitivity": "pseudonymous_product",
      "consentRequirement": "product_analytics",
      "retentionDays": 90,
      "aggregation": "operation_status",
      "source": "approved_view_action",
      "owner": "product"
    },
    {
      "name": "product_analytics_consent",
      "version": 1,
      "purpose": "Measure product-analytics consent grant, revoke, and deletion operations.",
      "allowedFields": ["traceId", "consentOperation", "status", "policyVersion"],
      "prohibitedFields": ["rawMessage", "exactIdentity", "memoryContent"],
      "sensitivity": "pseudonymous_operational",
      "consentRequirement": "none",
      "retentionDays": 90,
      "aggregation": "operation_status",
      "source": "analytics_consent",
      "owner": "privacy"
    },
    {
      "name": "observability_export",
      "version": 1,
      "purpose": "Measure exporter success, buffering, redaction, and failure isolation.",
      "allowedFields": ["traceId", "operation", "status", "resultCount", "latencyMs", "safeCode"],
      "prohibitedFields": ["rawMessage", "apiKey", "modelRequest", "modelResponse", "vector"],
      "sensitivity": "operational",
      "consentRequirement": "none",
      "retentionDays": 7,
      "aggregation": "operation_status",
      "source": "observability_service",
      "owner": "platform"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teoyube.local/schemas/stabilization/incident-record-1.0.0.json",
  "title": "Teoyube privacy-safe stabilization incident record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentId",
    "sessionId",
    "occurredAt",
    "route",
    "capability",
    "summary",
    "severity",
    "safeErrorCode",
    "reproductionSteps",
    "expectedBehavior",
    "actualBehavior",
    "visualImpact",
    "dataImpact",
    "securityPrivacyImpact",
    "scriptureCitationImpact",
    "safetyImpact",
    "workaround",
    "restartResult",
    "rollbackResult",
    "status",
    "resolutionCommit",
    "ownerConfirmed",
    "dataLoss",
    "crossUserAccess",
    "citationCorruption",
    "unsafeGuidance",
    "protectedVisualRegression",
    "criticalRuntimeFailure",
    "sensitiveContentIncluded",
    "reportedBy",
    "createdAt",
    "updatedAt",
    "recordHash"
  ],
  "properties": {
    "schemaVersion": { "const": "teoyube-stabilization-incident-1.0.0" },
    "incidentId": { "type": "string", "pattern": "^STAB-INCIDENT-[A-Z0-9_-]+$", "maxLength": 80 },
    "sessionId": { "type": "string", "pattern": "^STAB-SESSION-[A-Z0-9_-]+$", "maxLength": 80 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "route": { "$ref": "./session-record.schema.json#/$defs/route" },
    "capability": { "$ref": "./session-record.schema.json#/$defs/capability" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
    "safeErrorCode": { "type": "string", "pattern": "^[A-Z0-9_-]+$", "maxLength": 80 },
    "reproductionSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "expectedBehavior": { "type": "string", "maxLength": 1000 },
    "actualBehavior": { "type": "string", "maxLength": 1000 },
    "visualImpact": { "type": "string", "maxLength": 1000 },
    "dataImpact": { "type": "string", "maxLength": 1000 },
    "securityPrivacyImpact": { "type": "string", "maxLength": 1000 },
    "scriptureCitationImpact": { "type": "string", "maxLength": 1000 },
    "safetyImpact": { "type": "string", "maxLength": 1000 },
    "workaround": { "type": "string", "maxLength": 1000 },
    "restartResult": { "type": "string", "maxLength": 1000 },
    "rollbackResult": { "type": "string", "maxLength": 1000 },
    "status": { "enum": ["open", "investigating", "resolved"] },
    "resolutionCommit": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      ]
    },
    "ownerConfirmed": { "const": true },
    "dataLoss": { "type": "boolean" },
    "crossUserAccess": { "type": "boolean" },
    "citationCorruption": { "type": "boolean" },
    "unsafeGuidance": { "type": "boolean" },
    "protectedVisualRegression": { "type": "boolean" },
    "criticalRuntimeFailure": { "type": "boolean" },
    "sensitiveContentIncluded": { "const": false },
    "reportedBy": { "const": "owner" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "recordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

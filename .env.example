# Teoyube Production Launch Preparation environment template
# Placeholder values only. Do not put real secrets in this file.

# Existing optional YouTube placeholder
YOUTUBE_API_KEY=your_youtube_data_api_key

# Required launch preparation values
NODE_ENV=development
NEXT_PUBLIC_TEOYUBE_APP_ENV=preview
NEXT_PUBLIC_TEOYUBE_DEPLOYMENT_TARGET=undecided

# Safe public feature flags
NEXT_PUBLIC_TEOYUBE_ENABLE_PERSONALIZATION_PREVIEW=true
NEXT_PUBLIC_TEOYUBE_ENABLE_CONSENT_CONTROLS=true
NEXT_PUBLIC_TEOYUBE_ENABLE_OFFLINE_FALLBACK=true
NEXT_PUBLIC_TEOYUBE_ENABLE_DEBUG_UI=false

# Server-only future placeholders. These services are not enabled yet.
TEOYUBE_ANALYTICS_PROVIDER_KEY=disabled_until_later
TEOYUBE_DATABASE_URL=disabled_until_later
TEOYUBE_LIVE_AI_API_KEY=disabled_until_later
TEOYUBE_MONITORING_PROVIDER_KEY=disabled_until_later

# Production persistence, external analytics sending, live AI orchestration,
# service workers, and native mobile mode are intentionally disabled until later guarded launch steps.
